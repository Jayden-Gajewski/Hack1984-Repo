{
  "manifest_version": 3,
  "name": "Dossier Privacy Check",
  "short_name": "Dossier",
  "version": "0.1.0",
  "description": "See what each site's privacy policy says it collects and shares. Checked on your laptop by the local Dossier backend.",
  "minimum_chrome_version": "116",
  "incognito": "not_allowed",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://127.0.0.1:8000/*", "http://localhost:3000/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dossier Privacy Check",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
