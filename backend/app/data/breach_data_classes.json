  "field_types": {
    "_comment": "Stage 3 data types (models.FIELD_TYPES) for breaches found in news and official notices.",
    "name": "name", "email": "email", "phone": "phone", "address": "address",
    "birthdate": "birthdate", "ssn": "government_id", "password": "password",
