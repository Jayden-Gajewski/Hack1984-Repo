  "actions": {
    "change_password": {
      "text": "Change your {company} password",
      "why": "Passwords from this breach may be in attackers' lists. A new password makes the old one useless."
    },
    "unique_passwords": {
      "text": "Change the password anywhere else you used the same one",
      "why": "Attackers try leaked email and password pairs on other sites (credential stuffing)."
    },
    "enable_2fa": {
      "text": "Turn on two-factor authentication for {company}",
      "why": "A second step stops someone who only has your password."
    },
    "review_sessions": {
      "text": "Review active sessions and sign out devices you don't recognize",
      "why": "A stolen login token can keep someone signed in without your password."
    },
    "security_questions": {
      "text": "Change your security questions and answers",
      "why": "Leaked answers can be used to reset your password."
    },
    "phishing_watch": {
      "text": "Watch for emails, texts and calls that mention {company} or this breach",
      "why": "Scammers use breach news and leaked details to make phishing look real."
    },
    "carrier_pin": {
      "text": "Add a PIN or port-out lock with your mobile carrier",
      "why": "A leaked phone number makes SIM-swap attempts easier."
    },
    "credit_freeze": {
      "text": "Consider a credit freeze at Equifax, Experian and TransUnion",
      "why": "A freeze stops new credit being opened in your name. In the US it's free and you can lift it any time.",
      "link": "https://consumer.ftc.gov/articles/what-know-about-credit-freezes-and-fraud-alerts"
    },
    "credit_reports": {
      "text": "Check your credit reports for accounts you don't recognize",
      "why": "New accounts in your name are the first sign of identity theft.",
      "link": "https://www.annualcreditreport.com"
    },
    "card_check": {
      "text": "Check card and bank statements, and ask your bank about a replacement card",
      "why": "Exposed card details can be used for fraudulent charges."
    },
    "health_review": {
      "text": "Review insurance statements for care you didn't receive",
      "why": "Health and insurance details can be used for medical identity theft."
    },
    "rotate_secrets": {
      "text": "Change exposed PINs, and move funds from any wallet whose recovery phrase or key was exposed",
      "why": "These secrets give direct access; changing them is the only fix."
    },
    "remove_listings": {
      "text": "Run an exposure scan and request removal from people-search sites",
      "why": "Contact details from breaches often end up on people-search sites.",
      "link": "/app"
    },
    "read_notice": {
      "text": "Read {company}'s official notice and follow its instructions",
      "why": "The company's own notice says what it found and what it recommends."
    },
    "monitor_activity": {
      "text": "Watch your {company} account for activity you don't recognize",
      "why": "Unexpected logins, emails about changes or new devices are early warning signs."
    }
  }
