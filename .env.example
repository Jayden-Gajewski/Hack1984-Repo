# Copy this file to .env and fill it in. Never commit .env.
EXA_API_KEY=
TAVILY_API_KEY=

# LLM: Google's Gemini API. Get a key at https://aistudio.google.com/apikey
# Page text, privacy policies and breach notices are sent to Google, and every call is in the
# outbound log. On the free tier Google may use what you send to improve its products and
# people may read it; on the paid tier it doesn't.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash   # stable; gemini-3.8-flash is newer but was often overloaded
# GEMINI_PARALLEL=4        # Gemini calls at once; lower it if the free tier rate-limits you
# SCAN_MAX_PAGES=8         # pages analyzed per scan (known brokers first)

# Domain for generated aliases (stage 7)
ALIAS_DOMAIN=alias.local

# Public site only (docs/DEPLOY.md). Leave these unset on this laptop.
# SITE_URL=https://dossier-yourname.vercel.app
# SEARCHES_PER_DAY=20          # paid searches per account per day
# SEARCHES_PER_DAY_TOTAL=500   # the same, across every account

# Local PostgreSQL (docker compose up -d). Must stay on localhost.
DATABASE_URL=postgresql://hack:hack@localhost:5432/hack1984

# ---------- Threat monitor (all optional; see docs/THREAT_MONITOR.md) ----------
# Company breach matching needs nothing: HIBP's whole public breach list is downloaded and
# matched on this laptop.
#
# Email checks: a Have I Been Pwned key on a plan with the hashed (k-anonymity) search, Pro or
# High RPM. Only the first 6 characters of an address's SHA-1 hash are ever sent.
HIBP_API_KEY=
#
# Email ownership codes go out through your own SMTP server. Port 465 uses SSL; any other port
# must offer STARTTLS unless the host is localhost (a local test catcher like Mailpit on 1025).
# For Gmail: smtp.gmail.com, 587, your address, an app password (not your account password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
