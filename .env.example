# Copy this file to .env and fill it in. Never commit .env.
EXA_API_KEY=
TAVILY_API_KEY=

# Local LLM (Ollama). Install from https://ollama.com, then: ollama pull llama3.1:8b
# OLLAMA_URL must stay on localhost. The backend refuses to start otherwise.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# On a CPU-only laptop, qwen2.5:7b is faster, uses less RAM (~5.5 GB vs 6.3 GB) and was
# as accurate in testing. Avoid 3B models: they miss obvious matches.

# Performance (optional). Defaults suit a CPU-only 16 GB laptop.
# With a GPU, try OLLAMA_PARALLEL=2 and SCAN_MAX_PAGES=20.
# OLLAMA_NUM_CTX=6144      # LLM context in tokens; lower = less RAM
# OLLAMA_PARALLEL=1        # LLM calls at once
# OLLAMA_KEEP_ALIVE=2m     # free the model's RAM this long after the last call
# SCAN_MAX_PAGES=8         # pages analyzed per scan (known brokers first)

# Domain for generated aliases (stage 7)
ALIAS_DOMAIN=alias.local

# Local PostgreSQL (docker compose up -d). Must stay on localhost, like OLLAMA_URL.
DATABASE_URL=postgresql://hack:hack@localhost:5432/hack1984

# ---------- Threat monitor (all optional; see docs/THREAT_MONITOR.md) ----------
# Company breach matching needs nothing: HIBP's whole public breach list is downloaded and
# matched on this laptop.
#
# Email checks: a Have I Been Pwned key on a plan with the hashed (k-anonymity) search, Pro or
# High RPM. Only the first 6 characters of an address's SHA-1 hash are ever sent.
HIBP_API_KEY=
#
# Email ownership codes go out through your own SMTP server. Port 465 uses SSL; any other port
# must offer STARTTLS unless the host is localhost (a local test catcher like Mailpit on 1025).
# For Gmail: smtp.gmail.com, 587, your address, an app password (not your account password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
